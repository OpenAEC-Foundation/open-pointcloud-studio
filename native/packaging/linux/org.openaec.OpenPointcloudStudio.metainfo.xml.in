<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata; @VERSION@ and @DATE@ are filled in when a package is built. -->
<component type="desktop-application">
  <id>org.openaec.OpenPointcloudStudio</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Open Pointcloud Studio</name>
  <summary>View, measure, edit and export laser scans and point clouds</summary>
  <summary xml:lang="nl">Laserscans en puntenwolken bekijken, meten, bewerken en exporteren</summary>
  <developer id="org.openaec">
    <name>OpenAEC Foundation</name>
  </developer>
  <update_contact>info@open-aec.com</update_contact>
  <description>
    <p>
      Open Pointcloud Studio opens laser scans and other point clouds in the
      LAS, LAZ, E57, PLY, PCD, PTX and text formats, also when a survey is
      many gigabytes large: it shows a preview at once and reads the detail
      for the current view from an index on disk.
    </p>
    <p xml:lang="nl">
      Open Pointcloud Studio opent laserscans en andere puntenwolken in de
      formaten LAS, LAZ, E57, PLY, PCD, PTX en tekst, ook als een opname vele
      gigabytes groot is: het toont direct een voorbeeld en leest het detail
      voor het huidige beeld uit een index op schijf.
    </p>
    <p>
      A whole scan project opens from its folder. Scanner stations are shown
      with their photos, and you can stand in a station or walk through the
      scene. Points can be selected, deleted, thinned, moved and scaled,
      distances and areas measured, views saved with notes, and the result
      exported as a point cloud or a mesh.
    </p>
    <p xml:lang="nl">
      Een heel scanproject opent vanuit zijn map. Scanposities worden met hun
      foto's getoond, en je kunt in een scanpositie gaan staan of door de
      scène lopen. Punten zijn te selecteren, verwijderen, uitdunnen,
      verplaatsen en schalen, afstanden en oppervlakken te meten, aanzichten
      met notities op te slaan, en het resultaat is te exporteren als
      puntenwolk of mesh.
    </p>
  </description>
  <launchable type="desktop-id">org.openaec.OpenPointcloudStudio.desktop</launchable>
  <url type="homepage">https://github.com/OpenAEC-Foundation/open-pointcloud-studio</url>
  <url type="bugtracker">https://github.com/OpenAEC-Foundation/open-pointcloud-studio/issues</url>
  <url type="vcs-browser">https://github.com/OpenAEC-Foundation/open-pointcloud-studio</url>
  <categories>
    <category>Graphics</category>
    <category>3DGraphics</category>
    <category>Engineering</category>
  </categories>
  <provides>
    <binary>open-pointcloud-studio</binary>
    <mediatype>model/e57</mediatype>
    <mediatype>application/vnd.las</mediatype>
    <mediatype>application/vnd.laszip</mediatype>
    <mediatype>application/x-ply</mediatype>
    <mediatype>application/x-pcd</mediatype>
    <mediatype>application/x-ptx</mediatype>
    <mediatype>application/x-pts</mediatype>
    <mediatype>application/x-rcp</mediatype>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
